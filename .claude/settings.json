{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(node .claude/skills/pbi-delivery/scripts/*)",
      "PowerShell(node tools/build-plugin.js*)",
      "PowerShell(powerbi-report-author validate *)",
      "PowerShell(powerbi-report-author preview *)",
      "PowerShell(powerbi-report-author --version)",
      "Bash(node .claude/skills/pbi-delivery/scripts/*)",
      "Bash(node tools/build-plugin.js*)",
      "Bash(powerbi-report-author validate *)",
      "Bash(powerbi-report-author preview *)",
      "Bash(powerbi-report-author --version)"
    ],
    "deny": [
      "Read(**/cache.abf)",
      "Read(**/.pbi/localSettings.json)"
    ]
  }
}
